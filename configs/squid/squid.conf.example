# Squid transparent proxy config — NETS1037 Project 2
# Reconstructed from the actual build/test process — the OPNsense lab VM
# is no longer available, so this is not a live export. Reflects the
# working configuration confirmed during testing.

# --- Transparent interception ---
http_port 3128 intercept
https_port 3129 intercept ssl-bump \
    cert=/usr/local/etc/squid/ssl_cert/squid.pem \
    generate-host-certificates=on dynamic_cert_mem_cache_size=4MB

# --- SSL Bump / SNI-peek (requires internal CA, NOT a bare cert — see notes) ---
# NOTE: the CA must be issued as a CA certificate, not a leaf/server certificate.
# Using a plain cert here causes a segfault (confirmed during testing).
acl step1 at_step SslBump1
ssl_bump peek step1
ssl_bump splice all

# --- Domain blacklist (via SquidGuard) ---
url_rewrite_program /usr/local/bin/squidGuard -c /usr/local/etc/squidguard/squidGuard.conf
url_rewrite_children 20

# --- Logging (all requests) ---
access_log /var/log/squid/access.log squid

# --- Example ACL for blocked domains ---
# Both dotted and non-dotted entries required to match bare apex + subdomains
acl blocked_domains dstdomain "/usr/local/etc/squid/blocked_domains.txt"
http_access deny blocked_domains
