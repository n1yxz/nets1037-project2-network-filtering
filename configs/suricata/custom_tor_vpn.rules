# Custom Suricata rules — NETS1037 Project 2
# Placed under Services > Intrusion Detection > Administration > Rules (custom.rules)
# Suricata is a built-in core service on OPNsense, not an installable plugin.

# --- Tor OR port traffic ---
alert tcp any any -> any 9001 (msg:"POLICY Tor OR port traffic detected"; \
    flow:to_server; classtype:policy-violation; sid:9000001; rev:1;)

# --- No-SNI TLS handshake (common Tor/VPN circumvention indicator) ---
alert tls any any -> any any (msg:"POLICY TLS handshake with no SNI extension"; \
    tls.sni; content:!"|00|"; classtype:policy-violation; sid:9000002; rev:1;)

# --- WireGuard handshake signature (Mozilla VPN, standard WireGuard) ---
alert udp any any -> any 51820 (msg:"POLICY Possible WireGuard VPN handshake"; \
    flow:to_server; classtype:policy-violation; sid:9000003; rev:1;)

# --- OpenVPN handshake signature ---
alert udp any any -> any 1194 (msg:"POLICY Possible OpenVPN handshake"; \
    flow:to_server; classtype:policy-violation; sid:9000004; rev:1;)

# --- IKEv2 / IPsec VPN ---
alert udp any any -> any [500,4500] (msg:"POLICY Possible IKEv2/IPsec VPN traffic"; \
    flow:to_server; classtype:policy-violation; sid:9000005; rev:1;)

# NOTE: These are POLICY-level alerts (log/detect), not DROP rules by default.
# Switch action to "drop" in IPS mode if you want active blocking rather than logging.
